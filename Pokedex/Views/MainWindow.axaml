<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pokedex.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Pokedex.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Pokedex">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,*">
        <Image Grid.Column="0" Source="{Binding SpriteImage}" />
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding SelectedPokemon.Name}" />
            <TextBlock Text="{Binding SelectedPokemon.Weight}" />
            <TextBlock Text="{Binding SelectedPokemon.Height}" />
        </StackPanel>
    </Grid>
</Window>
